{
  "name": "Fortune 500 Executive Corporate Theme",
  "dataColors": [
    "#1E3A8A",
    "#0EA5E9",
    "#10B981",
    "#F59E0B",
    "#6366F1",
    "#EC4899",
    "#64748B"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#1E3A8A",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#F8FAFC" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "transparency": 92
          }
        ]
      }
    }
  }
}
